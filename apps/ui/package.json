{
  "name": "@shopifruta/ui",
  "version": "1.0.0",
  "private": true,
  "description": "ShopiFruta UI component library (Button, Badge, Card, Modal) built with Tailwind CSS and class-variance-authority, documented in Storybook.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.json --external 'react' --external 'react-dom' --inject-style",
    "chromatic": "chromatic --exit-zero-on-changes",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "storybook"
  ],
  "author": "Andrés Largo <contacto@andreslargo.com>",
  "license": "ISC",
  "devDependencies": {
    "@chromatic-com/storybook": "^3",
    "@storybook/addon-essentials": "^8.6.11",
    "@storybook/addon-onboarding": "^8.6.11",
    "@storybook/blocks": "^8.6.11",
    "@storybook/experimental-addon-test": "^8.6.11",
    "@storybook/test": "^8.6.11",
    "@tailwindcss/postcss": "^4.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.2.0",
    "@vitest/browser": "3.0.9",
    "@vitest/coverage-v8": "3.0.9",
    "autoprefixer": "^10.4.21",
    "chromatic": "^11.28.0",
    "playwright": "^1.51.1",
    "postcss": "^8.5.3",
    "storybook": "^8.6.11",
    "tailwindcss": "^4.1.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "class-variance-authority": "^0.7.1"
  }
}
